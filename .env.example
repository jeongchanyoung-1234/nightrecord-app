# 복사: cp .env.example .env 후 값을 채우세요. .env는 git에 올리지 않습니다.

NIGHTRECORD_HOST=127.0.0.1
NIGHTRECORD_PORT=8080
NIGHTRECORD_DB=data/nightrecord.sqlite
NIGHTRECORD_PUBLIC_URL=https://nightrecord.app
NIGHTRECORD_CORS_ORIGIN=https://nightrecord.app,https://dev.nightrecord.app

# 관리자 계정 (서버 기동 시 시드)
NIGHTRECORD_ADMIN_USERNAME=
NIGHTRECORD_ADMIN_PASSWORD=

# SMTP (비밀번호 재설정 메일 — 없으면 관련 기능 비활성)
NIGHTRECORD_SMTP_HOST=
NIGHTRECORD_SMTP_PORT=587
NIGHTRECORD_SMTP_USER=
NIGHTRECORD_SMTP_PASSWORD=
NIGHTRECORD_SMTP_FROM=
